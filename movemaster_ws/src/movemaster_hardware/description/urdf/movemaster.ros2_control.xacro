<?xml version="1.0"?>
<!--
  Bloque <ros2_control> del Movemaster: 3 SPARK MAX en Position Control.

  Cada <joint> puede sobrescribir los valores de movemaster_config.hpp:
    can_id, gear_ratio, inverted, offset_rad, pid_slot, p, i, d, f,
    i_zone, d_filter, output_min, output_max
  Si un parámetro se omite se usa el valor dentro del código
  (movemaster_driver/include/movemaster_driver/movemaster_config.hpp).
  Los límites de posición se toman de <command_interface> min/max.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="movemaster_joint" params="name can_id lower upper">
    <joint name="${name}">
      <param name="can_id">${can_id}</param>
      <!-- Reductor: vueltas del motor por vuelta de la articulación.
           Descomentar para sobrescribir kGearRatios del código:
      <param name="gear_ratio">100.0</param>
      <param name="inverted">false</param>
      <param name="offset_rad">0.0</param>
      -->
      <param name="pid_slot">0</param>
      <param name="p">1.0</param>
      <param name="i">0.0</param>
      <param name="d">0.0</param>
      <param name="f">0.0</param>
      <command_interface name="position">
        <param name="min">${lower}</param>
        <param name="max">${upper}</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="current">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
  </xacro:macro>

  <xacro:macro name="movemaster_ros2_control" params="name use_mock_hardware:=false can_interface:=can0">
    <ros2_control name="${name}" type="system">
      <hardware>
        <xacro:if value="${use_mock_hardware}">
          <plugin>mock_components/GenericSystem</plugin>
        </xacro:if>
        <xacro:unless value="${use_mock_hardware}">
          <plugin>movemaster_hardware/MovemasterHardware</plugin>
          <param name="can_interface">${can_interface}</param>
          <!-- Vacío = share/sparkmax_protocol/spec/spark-frames-2.1.0 -->
          <param name="frames_json"></param>
          <param name="status_period_ms">20</param>
          <param name="feedback_timeout_ms">300</param>
          <param name="response_timeout_ms">500</param>
          <param name="feedback_wait_ms">2000</param>
          <param name="persist_parameters">false</param>
          <param name="trip_on_error_frame">true</param>
        </xacro:unless>
      </hardware>

      <xacro:movemaster_joint name="joint_1" can_id="1" lower="${-pi}" upper="${pi}"/>
      <xacro:movemaster_joint name="joint_2" can_id="2" lower="${-pi}" upper="${pi}"/>
      <xacro:movemaster_joint name="joint_3" can_id="3" lower="${-pi}" upper="${pi}"/>
    </ros2_control>
  </xacro:macro>

</robot>
