<?xml version="1.0"?>
<!--
  Descripción mínima de 3 articulaciones rotacionales para el Movemaster.
  La geometría es provisional: sustituir por las medidas/mallas reales.
-->
<robot name="movemaster" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="use_mock_hardware" default="false"/>
  <xacro:arg name="can_interface" default="can0"/>

  <xacro:include filename="$(find movemaster_hardware)/description/urdf/movemaster.ros2_control.xacro"/>

  <xacro:property name="link_length" value="0.20"/>
  <xacro:property name="link_radius" value="0.03"/>

  <xacro:macro name="arm_link" params="name">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 ${link_length / 2}"/>
        <geometry><cylinder length="${link_length}" radius="${link_radius}"/></geometry>
      </visual>
      <collision>
        <origin xyz="0 0 ${link_length / 2}"/>
        <geometry><cylinder length="${link_length}" radius="${link_radius}"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 ${link_length / 2}"/>
        <mass value="0.5"/>
        <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.0003"/>
      </inertial>
    </link>
  </xacro:macro>

  <link name="world"/>
  <link name="base_link">
    <visual><geometry><box size="0.15 0.15 0.05"/></geometry></visual>
  </link>
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
  </joint>

  <xacro:arm_link name="link_1"/>
  <xacro:arm_link name="link_2"/>
  <xacro:arm_link name="link_3"/>

  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 0.025"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-pi}" upper="${pi}" effort="50" velocity="1.0"/>
  </joint>
  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0 0 ${link_length}"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-pi}" upper="${pi}" effort="50" velocity="1.0"/>
  </joint>
  <joint name="joint_3" type="revolute">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin xyz="0 0 ${link_length}"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-pi}" upper="${pi}" effort="50" velocity="1.0"/>
  </joint>

  <xacro:movemaster_ros2_control name="MovemasterSystem"
    use_mock_hardware="$(arg use_mock_hardware)" can_interface="$(arg can_interface)"/>

</robot>
