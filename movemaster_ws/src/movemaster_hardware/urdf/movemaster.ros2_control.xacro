<?xml version="1.0"?>
<!--
  Bloque ros2_control del Movemaster. Inclúyelo desde el URDF/xacro del robot:

    <xacro:include filename="$(find movemaster_hardware)/urdf/movemaster.ros2_control.xacro"/>
    <xacro:movemaster_ros2_control name="MovemasterSystem"/>

  Los valores de gear_ratio, offset, límites y ganancias son EJEMPLOS: ajústalos
  a la mecánica real. gear_ratio = rotaciones del motor por rotación de la
  articulación (negativo invierte el sentido); offset = ángulo [rad] de la
  articulación cuando el encoder del NEO marca 0 rotaciones (no hay homing).
  PIDF/perfil: mismas unidades que el backend Python (RPM/s, RPM, rotaciones).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="movemaster_joint" params="name can_id gear_ratio offset min max">
    <joint name="${name}">
      <command_interface name="position">
        <param name="min">${min}</param>
        <param name="max">${max}</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="current"/>
      <param name="can_id">${can_id}</param>
      <param name="gear_ratio">${gear_ratio}</param>
      <param name="offset">${offset}</param>
      <param name="p">1.0</param>
      <param name="i">0.0</param>
      <param name="d">0.0</param>
      <param name="f">0.0</param>
      <param name="max_acceleration">500.0</param>
      <param name="cruise_velocity">900.0</param>
      <param name="allowed_profile_error">0.1</param>
    </joint>
  </xacro:macro>

  <xacro:macro name="movemaster_ros2_control" params="name can_interface:=can0">
    <ros2_control name="${name}" type="system">
      <hardware>
        <plugin>movemaster_hardware/MovemasterHardware</plugin>
        <param name="can_interface">${can_interface}</param>
        <!-- Vacío = share/movemaster_hardware/config/spark-frames-2.1.0.json -->
        <param name="frames_json"></param>
        <param name="pid_slot">0</param>
        <param name="status_period_ms">20</param>
        <param name="feedback_timeout">0.3</param>
        <param name="response_timeout">0.5</param>
        <param name="disable_settle_time">0.5</param>
        <param name="feedback_wait_timeout">2.0</param>
        <param name="persist_parameters">false</param>
      </hardware>

      <xacro:movemaster_joint name="joint_1" can_id="1" gear_ratio="100.0" offset="0.0"
                              min="-1.57" max="1.57"/>
      <xacro:movemaster_joint name="joint_2" can_id="2" gear_ratio="100.0" offset="0.0"
                              min="-1.57" max="1.57"/>
      <xacro:movemaster_joint name="joint_3" can_id="3" gear_ratio="100.0" offset="0.0"
                              min="-1.57" max="1.57"/>
    </ros2_control>
  </xacro:macro>

</robot>
