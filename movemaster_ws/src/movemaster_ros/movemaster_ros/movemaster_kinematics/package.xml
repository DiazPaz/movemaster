<?xml version="1.0"?>
<package format="3">
  <name>movemaster_kinematics</name>
  <version>0.1.0</version>
  <description>Forward and closed-form inverse kinematics of MoveMaster, from the DH table and joint limits of the URDF.</description>
  <maintainer email="maintainer@example.com">MoveMaster project (replace before publishing)</maintainer>
  <license>Proprietary</license>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>movemaster_description</exec_depend>
  <exec_depend>movemaster_hardware</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
