<?xml version="1.0"?>
<!-- Include this macro from the robot URDF. It does not define geometry.
     The joints come from joint_config_path (joints.json), in file order, so the
     ros2_control block always matches the joint list the plugin requires. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- initial_value is only read by mock hardware; MovemasterHardware reads the encoders. -->
  <xacro:macro name="movemaster_control_joint" params="name initial_position:=0.0">
    <joint name="${name}">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">${initial_position}</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="current"/>
    </joint>
  </xacro:macro>

  <!-- One joint per entry of joints.json; mock hardware starts at 0 rad clamped to the limits. -->
  <xacro:macro name="movemaster_control_joints" params="joints names">
    <xacro:if value="${names}">
      <xacro:property name="lower" value="${float(joints[names[0]]['min_position_rad'])}"/>
      <xacro:property name="upper" value="${float(joints[names[0]]['max_position_rad'])}"/>
      <xacro:movemaster_control_joint name="${names[0]}" initial_position="${min(max(0.0, lower), upper)}"/>
      <xacro:movemaster_control_joints joints="${joints}" names="${names[1:]}"/>
    </xacro:if>
  </xacro:macro>

  <!-- use_mock_hardware:=true swaps the plugin for mock_components/GenericSystem, with the
       same interfaces, to run the controllers without CAN or motors. -->
  <xacro:macro name="movemaster_ros2_control"
               params="name spec_path joint_config_path can_interface:=can0 use_mock_hardware:=false">
    <xacro:property name="joints" value="${xacro.load_yaml(joint_config_path)['joints']}"/>
    <ros2_control name="${name}" type="system">
      <hardware>
        <xacro:if value="${use_mock_hardware}">
          <plugin>mock_components/GenericSystem</plugin>
        </xacro:if>
        <xacro:unless value="${use_mock_hardware}">
          <plugin>movemaster_hardware/MovemasterHardware</plugin>
          <param name="spec_path">${spec_path}</param>
          <param name="joint_config_path">${joint_config_path}</param>
          <param name="can_interface">${can_interface}</param>
        </xacro:unless>
      </hardware>
      <xacro:movemaster_control_joints joints="${joints}" names="${list(joints)}"/>
    </ros2_control>
  </xacro:macro>
</robot>
