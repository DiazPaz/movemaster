<?xml version="1.0"?>
<!-- Robot description for the MoveMaster controller_manager.
     Every joint, with its limits and maximum velocity, comes from joints.json.
     The links carry no geometry yet: this chain only gives ros2_control and
     robot_state_publisher the joints they need, until movemaster_description
     provides the real kinematics. -->
<robot name="movemaster" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="joint_config" default="$(find movemaster_hardware)/config/joints.json"/>
  <xacro:arg name="spec_path" default="$(find movemaster_hardware)/spec/spark-frames-2.1.0"/>
  <xacro:arg name="can_interface" default="can0"/>
  <xacro:arg name="use_mock_hardware" default="false"/>

  <xacro:include filename="$(find movemaster_hardware)/config/ros2_control.xacro"/>

  <!-- Serial chain: one revolute joint per entry of joints.json, in file order.
       The velocity limit is the MAXMotion cruise velocity (motor RPM) divided by
       gear_ratio. URDF requires effort; it is unused because the joints are
       position controlled. -->
  <xacro:macro name="movemaster_chain" params="parent joints names">
    <xacro:if value="${names}">
      <xacro:property name="joint_name" value="${names[0]}"/>
      <xacro:property name="config" value="${joints[joint_name]}"/>
      <joint name="${joint_name}" type="revolute">
        <parent link="${parent}"/>
        <child link="${joint_name}_link"/>
        <axis xyz="0 0 1"/>
        <limit lower="${float(config['min_position_rad'])}"
               upper="${float(config['max_position_rad'])}"
               velocity="${float(config['maxmotion']['cruise_velocity']) * 2 * pi / 60 / float(config['gear_ratio'])}"
               effort="0"/>
      </joint>
      <link name="${joint_name}_link"/>
      <xacro:movemaster_chain parent="${joint_name}_link" joints="${joints}" names="${names[1:]}"/>
    </xacro:if>
  </xacro:macro>

  <xacro:property name="joint_config" value="$(arg joint_config)"/>
  <xacro:property name="joints" value="${xacro.load_yaml(joint_config)['joints']}"/>

  <link name="base_link"/>
  <xacro:movemaster_chain parent="base_link" joints="${joints}" names="${list(joints)}"/>

  <xacro:movemaster_ros2_control name="MovemasterSystem"
      spec_path="$(arg spec_path)"
      joint_config_path="${joint_config}"
      can_interface="$(arg can_interface)"
      use_mock_hardware="$(arg use_mock_hardware)"/>
</robot>
